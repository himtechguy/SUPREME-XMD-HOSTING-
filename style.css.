
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #080b14;
  --panel: #111827;
  --border: #263449;
  --blue: #00d9ff;
  --text: #f5f7fb;
  --muted: #91a0b5;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: Arial, sans-serif;
}

.app {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 250px;
  background: #0d1421;
  border-right: 1px solid var(--border);
  padding: 25px 18px;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 45px;
}

.brand-icon,
.avatar {
  background: var(--blue);
  color: #001018;
  padding: 12px;
  border-radius: 10px;
  font-weight: bold;
}

.brand h2 {
  font-size: 16px;
}

.brand span,
.eyebrow {
  color: var(--blue);
  font-size: 10px;
  letter-spacing: 2px;
}

nav {
  display: grid;
  gap: 10px;
}

.nav-link {
  color: var(--muted);
  text-decoration: none;
  padding: 13px;
  border-radius: 8px;
}

.nav-link:hover,
.nav-link.active {
  background: #17263a;
  color: var(--blue);
}

.sidebar-bottom {
  margin-top: auto;
  color: var(--muted);
  font-size: 12px;
}

.sidebar-bottom small {
  display: block;
  margin-top: 10px;
}

.status-dot,
.live-label i {
  display: inline-block;
  width: 8px;
  height: 8px;
  background: #00e69a;
  border-radius: 50%;
  margin-right: 6px;
}

.main-content {
  flex: 1;
  padding: 30px;
  max-width: 1500px;
}

.topbar,
.section-heading,
.panel-heading,
.settings-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

h1 {
  font-size: 30px;
  margin-top: 8px;
}

h2 {
  margin-top: 8px;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--panel);
  padding: 8px 12px;
  border-radius: 30px;
  font-size: 13px;
}

.avatar {
  padding: 8px 11px;
  border-radius: 50%;
}

.welcome {
  background: linear-gradient(120deg, #10243a, #111827);
  border: 1px solid var(--border);
  padding: 30px;
  border-radius: 15px;
  margin-top: 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.welcome h2 {
  font-size: 25px;
}

.welcome p,
.panel p,
.settings-panel p {
  color: var(--muted);
  margin-top: 12px;
  line-height: 1.6;
}

.welcome-mark {
  color: var(--blue);
  font-size: 55px;
  font-weight: bold;
  opacity: .5;
}

.section {
  margin-top: 35px;
}

.live-label,
.console-tag,
.version {
  color: #00e69a;
  font-size: 11px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-top: 20px;
}

.stat-card,
.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
}

.stat-icon,
.panel-icon {
  color: var(--blue);
  font-size: 25px;
}

.stat-card p {
  color: var(--muted);
  font-size: 13px;
  margin: 15px 0 8px;
}

.stat-card h3 {
  font-size: 19px;
}

.stat-card small,
.hint {
  display: block;
  color: var(--muted);
  font-size: 11px;
  margin-top: 10px;
}

.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.panel-heading {
  margin-bottom: 15px;
}

.input-group {
  margin-top: 20px;
}

label {
  display: block;
  color: var(--muted);
  font-size: 12px;
  margin-bottom: 8px;
}

input {
  width: 100%;
  padding: 13px;
  background: #080e19;
  border: 1px solid var(--border);
  border-radius: 8px;
  color: white;
  outline: none;
}

input:focus {
  border-color: var(--blue);
}

button {
  padding: 13px 16px;
  border: 0;
  border-radius: 8px;
  margin-top: 15px;
  font-weight: bold;
  cursor: pointer;
}

.primary-button {
  background: var(--blue);
  color: #001018;
}

.secondary-button {
  background: #1b2b40;
  color: white;
}

button:disabled {
  opacity: .5;
  cursor: not-allowed;
}

.session-box {
  background: #080e19;
  border: 1px solid var(--border);
  padding: 17px;
  margin-top: 20px;
  border-radius: 8px;
}

.session-box span,
.session-box strong {
  display: block;
}

.session-box span {
  color: var(--muted);
  font-size: 10px;
  margin-bottom: 8px;
}

.console {
  background: #05080e;
  border: 1px solid var(--border);
  padding: 20px;
  border-radius: 10px;
  margin-top: 15px;
  min-height: 100px;
  font-family: monospace;
  font-size: 12px;
  overflow-wrap: anywhere;
}

.console p {
  margin-bottom: 12px;
  color: #b8c5d8;
}

.console-time {
  color: var(--blue);
}

.settings-panel {
  flex-wrap: wrap;
}

footer {
  border-top: 1px solid var(--border);
  padding-top: 20px;
  margin-top: 40px;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  color: var(--muted);
  font-size: 11px;
}

@media (max-width: 850px) {
  .app {
    display: block;
  }

  .sidebar {
    width: 100%;
    padding: 18px;
  }

  .brand {
    margin-bottom: 20px;
  }

  nav {
    display: flex;
    overflow-x: auto;
  }

  .nav-link {
    white-space: nowrap;
  }

  .sidebar-bottom {
    display: none;
  }

  .main-content {
    padding: 18px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .two-column {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 450px) {
  .welcome-mark {
    display: none;
  }

  .topbar {
    align-items: flex-start;
  }

  .user-chip {
    font-size: 11px;
  }

  footer {
    flex-direction: column;
  }
}
